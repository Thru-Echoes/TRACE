{
  "include": ["src", "tests", "scripts", "examples"],
  "exclude": ["**/__pycache__"],
  "extraPaths": ["."],
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning"
}
