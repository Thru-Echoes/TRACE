{
  "$defs": {
    "Actor": {
      "additionalProperties": true,
      "description": "Who performed an action.",
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "system"
          ],
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AnnotationData": {
      "additionalProperties": true,
      "description": "Free-form observations, learnings, gotchas, corrections, todos.",
      "properties": {
        "category": {
          "enum": [
            "learning",
            "gotcha",
            "observation",
            "correction",
            "todo",
            "question",
            "discovery",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "corrects_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Corrects Event Ids",
          "type": "array"
        },
        "related_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Event Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "category",
        "content"
      ],
      "title": "AnnotationData",
      "type": "object"
    },
    "ContributionData": {
      "additionalProperties": true,
      "description": "Records a contribution with direction-vs-execution attribution.\n\nCaptures who had the idea (direction) vs who did the work (execution),\nlinking back to the decisions that motivated this contribution.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact"
        },
        "direction": {
          "enum": [
            "human",
            "ai",
            "collaborative"
          ],
          "title": "Direction",
          "type": "string"
        },
        "execution": {
          "enum": [
            "human",
            "ai",
            "collaborative"
          ],
          "title": "Execution",
          "type": "string"
        },
        "related_decision_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Decision Ids",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "description",
        "direction",
        "execution"
      ],
      "title": "ContributionData",
      "type": "object"
    },
    "DecisionConfidence": {
      "additionalProperties": true,
      "description": "The producer-recorded measurement that motivated a decision (v0.5.1): the estimated effect,\nits interval, the method, the sample size, and the files it rests on.\n\nA positive ``estimate`` favours the option the decision describes; the producer orients the\nstatistic that way. ``direction`` records the native sense of the underlying raw metric\n(``\"lower\"`` means the raw metric is better when smaller) so a reader can relate the estimate\nback to it. This object carries the measurement only. A producer's decision rule (a minimum\neffect, a verdict, a held-out check, a confirmation policy) travels as preserved extra keys\nidentified by ``contract``; TRACE stores those untouched and never interprets them. Nothing\nhere says whether the decision was right.\n\nField order follows the contract's section 2 listing.",
      "properties": {
        "interval": {
          "$ref": "#/$defs/MeasurementInterval"
        },
        "method": {
          "$ref": "#/$defs/MeasurementMethod"
        },
        "sample_size": {
          "minimum": 1,
          "title": "Sample Size",
          "type": "integer"
        },
        "evidence_digests": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Digests"
        },
        "contract": {
          "anyOf": [
            {
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract"
        },
        "statistic": {
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Statistic",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "direction": {
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "interval",
        "method",
        "sample_size",
        "statistic",
        "direction",
        "estimate"
      ],
      "title": "DecisionConfidence",
      "type": "object"
    },
    "DecisionData": {
      "additionalProperties": true,
      "description": "Records a decision with full attribution and resolution status.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "proposed_by": {
          "$ref": "#/$defs/Actor"
        },
        "disposition": {
          "default": "proposed",
          "enum": [
            "proposed",
            "accepted",
            "revised",
            "rejected"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "resolved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Note"
        },
        "revises_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revises Event Id"
        },
        "suggestion_type": {
          "anyOf": [
            {
              "enum": [
                "proactive",
                "requested",
                "collaborative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion Type"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionConfidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "description",
        "proposed_by"
      ],
      "title": "DecisionData",
      "type": "object"
    },
    "Environment": {
      "description": "Execution context for reproducibility.\n\nv0.4.1: `trace_version` removed from Environment to eliminate the\ntwo-source-of-truth problem. The single canonical version lives on\n`Session.trace_version`. Existing v0.3.x/v0.4.0 session files that\nhave `environment.trace_version` set load cleanly via Pydantic v2\ndefault `extra='ignore'` (the field is silently dropped).",
      "properties": {
        "mcp_servers": {
          "items": {
            "type": "string"
          },
          "title": "Mcp Servers",
          "type": "array"
        },
        "client": {
          "default": "",
          "title": "Client",
          "type": "string"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        },
        "custom": {
          "additionalProperties": true,
          "title": "Custom",
          "type": "object"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "EventContext": {
      "additionalProperties": true,
      "description": "Shared context attached to any event.",
      "properties": {
        "conversation_turn": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Turn"
        },
        "reasoning_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Summary"
        },
        "conversation_snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Snippet"
        },
        "related_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Event Ids",
          "type": "array"
        }
      },
      "title": "EventContext",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": true,
      "description": "A file a measurement rests on, by role, locator and SHA-256 (v0.5.1).\n\nA matching digest shows that a holder's bytes match the recorded digest. It does not show that\nthe measurement was computed from those bytes, who produced the file, or that it is authentic.",
      "properties": {
        "role": {
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Role",
          "type": "string"
        },
        "locator": {
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Locator",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "locator",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MeasurementInterval": {
      "additionalProperties": true,
      "description": "An interval on a measured effect: lower and upper bounds and the nominal coverage (v0.5.1).",
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "level": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Level",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "level"
      ],
      "title": "MeasurementInterval",
      "type": "object"
    },
    "MeasurementMethod": {
      "additionalProperties": true,
      "description": "How an interval was computed (v0.5.1).\n\n``name`` is a free identifier; consumers MUST NOT reject an unknown one. ``algorithm`` names the\nexact procedure when the producer has one.",
      "properties": {
        "name": {
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Name",
          "type": "string"
        },
        "algorithm": {
          "anyOf": [
            {
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm"
        },
        "resamples": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resamples"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "name"
      ],
      "title": "MeasurementMethod",
      "type": "object"
    },
    "SessionMetadata": {
      "additionalProperties": true,
      "description": "Descriptive metadata for a session.",
      "properties": {
        "project": {
          "title": "Project",
          "type": "string"
        },
        "project_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Canonical project key (spec v0.5 \u00a73.2.1) \u2014 authoritative when present. Consumers MUST fall back to resolving `project` through the alias table or the canonical-key algorithm when it is absent, which is the case for every session written before v0.5. Deliberately carries no schema pattern: constraining it would retroactively invalidate live documents. Consumers MUST NOT assume a rewriting intermediary maintains it \u2014 a version-skewed writer preserves the field but does not re-derive it.",
          "title": "Project Key"
        },
        "experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/Actor"
          },
          "title": "Participants",
          "type": "array"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Environment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "custom": {
          "additionalProperties": true,
          "title": "Custom",
          "type": "object"
        }
      },
      "required": [
        "project"
      ],
      "title": "SessionMetadata",
      "type": "object"
    },
    "StateChangeData": {
      "additionalProperties": true,
      "description": "Records a change in environment, configuration, or tools.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "old_value": {
          "default": null,
          "title": "Old Value"
        },
        "new_value": {
          "default": null,
          "title": "New Value"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "description"
      ],
      "title": "StateChangeData",
      "type": "object"
    },
    "ToolCallData": {
      "additionalProperties": true,
      "description": "Records a tool or service invocation (MCP, external non-MCP, or host-internal).",
      "properties": {
        "server": {
          "title": "Server",
          "type": "string"
        },
        "method": {
          "default": "tools/call",
          "title": "Method",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "output": {
          "default": null,
          "title": "Output"
        },
        "output_truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Truncated"
        },
        "output_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "status": {
          "default": "success",
          "enum": [
            "success",
            "error",
            "timeout"
          ],
          "title": "Status",
          "type": "string"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "retries_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retries Event Id"
        },
        "host": {
          "default": "mcp",
          "enum": [
            "mcp",
            "internal",
            "external"
          ],
          "title": "Host",
          "type": "string"
        },
        "parent_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Event Id"
        }
      },
      "required": [
        "server",
        "name",
        "input"
      ],
      "title": "ToolCallData",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": true,
      "description": "A single audit event. The core unit of TRACE.",
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "tool_call",
            "decision",
            "annotation",
            "state_change",
            "contribution"
          ],
          "title": "Type",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "tool_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "annotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnnotationData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateChangeData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContributionData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context": {
          "$ref": "#/$defs/EventContext"
        }
      },
      "required": [
        "session_id",
        "type",
        "actor"
      ],
      "title": "TraceEvent",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "JSON Schema for a session document conforming to the Decision Provenance for AI-Assisted Workflows specification v0.5.1. See: https://trace-protocol.org/v0.3 (namespace URI kept at v0.3# per ADR 002 D6 \u2014 additive extensions are valid within the same namespace).",
  "properties": {
    "context": {
      "default": "https://trace-protocol.org/v0.3",
      "title": "Context",
      "type": "string"
    },
    "trace_version": {
      "default": "0.5.1",
      "description": "Wire/schema format version this record conforms to. Decoupled from the package version (trace_mcp.__version__): wire-compatible releases keep this at the schema version. See SCHEMA_VERSION.",
      "title": "Trace Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "created": {
      "format": "date-time",
      "title": "Created",
      "type": "string"
    },
    "ended": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "completed",
        "abandoned"
      ],
      "title": "Status",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/SessionMetadata"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "id",
    "metadata"
  ],
  "title": "Decision Provenance Session Document v0.5.1",
  "type": "object",
  "$id": "https://trace-protocol.org/schemas/trace-v0.5.json"
}
